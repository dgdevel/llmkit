# Makefile.cross - Cross-compilation targets for MinGW-w64 (Linux -> Windows)
# Include from main Makefile or invoke directly: make -f Makefile.cross windows

MINGW_W64   ?= x86_64-w64-mingw32
MINGW_CC     = $(MINGW_W64)-gcc
MINGW_CFLAGS  = -Os -g0 -Wall -Wextra -Wpedantic -std=c17 -D_DEFAULT_SOURCE -DCURL_STATICLIB
MINGW_LDFLAGS = -static -static-libgcc -static-libstdc++
MINGW_LIBS    = -lyaml -lcurl -lcrypto -lssl -lws2_32 -lbcrypt
MINGW_TARGET  = llmkit.exe

SRCDIR   := src
MINGW_OBJDIR := build-win

SOURCES  := $(wildcard $(SRCDIR)/*.c)
MINGW_OBJS := $(patsubst $(SRCDIR)/%.c,$(MINGW_OBJDIR)/%.o,$(SOURCES))

SCRIPTS  := scripts

# Format / lint tools (host tools; clang-tidy analyzes the C source text,
# not the cross-compiled output, so it runs identically for native and
# cross builds). Both are overridable.
CLANG_FORMAT ?= clang-format
CLANG_TIDY   ?= clang-tidy

# Files checked by clang-format / clang-tidy. The non-recursive glob
# $(SRCDIR)/*.c deliberately excludes src/vendor/* (vendored code).
FORMAT_SOURCES := $(SRCDIR)/*.c $(SRCDIR)/*.h tests/*.c
LINT_SOURCES   := $(SOURCES) $(wildcard tests/*.c)

# Auto-detect MinGW library paths via pkg-config
MINGW_PKG_CONFIG := PKG_CONFIG_LIBDIR=/usr/$(MINGW_W64)/lib/pkgconfig pkg-config
# Filter out -R (Solaris rpath) flags not recognized by GCC
MINGW_PC_FILTER  = sed 's/-R[^ ]*//g'

MINGW_YAML_CFLAGS  := $(shell $(MINGW_PKG_CONFIG) --cflags yaml-0.1 2>/dev/null)
MINGW_YAML_LIBS    := $(shell $(MINGW_PKG_CONFIG) --libs --static yaml-0.1 2>/dev/null | $(MINGW_PC_FILTER) || echo "-lyaml")
MINGW_CURL_CFLAGS  := $(shell $(MINGW_PKG_CONFIG) --cflags libcurl 2>/dev/null)
MINGW_CURL_LIBS    := $(shell $(MINGW_PKG_CONFIG) --libs --static libcurl 2>/dev/null | $(MINGW_PC_FILTER) || echo "-lcurl")
MINGW_CRYPTO_CFLAGS:= $(shell $(MINGW_PKG_CONFIG) --cflags libcrypto 2>/dev/null)
MINGW_CRYPTO_LIBS  := $(shell $(MINGW_PKG_CONFIG) --libs --static libcrypto 2>/dev/null | $(MINGW_PC_FILTER) || echo "-lcrypto")
MINGW_SSL_LIBS     := $(shell $(MINGW_PKG_CONFIG) --libs --static libssl 2>/dev/null | $(MINGW_PC_FILTER) || echo "-lssl")

# cJSON: prefer system MinGW, fall back to vendored
MINGW_CJSON_CFLAGS :=
MINGW_CJSON_LIBS   :=
ifneq ($(shell $(MINGW_PKG_CONFIG) --exists libcjson 2>/dev/null && echo yes),yes)
  ifneq ($(wildcard $(SRCDIR)/vendor/cJSON.c),)
    MINGW_CJSON_CFLAGS := -I$(SRCDIR)/vendor
    MINGW_CJSON_SRC    := $(SRCDIR)/vendor/cJSON.c
  endif
else
  MINGW_CJSON_CFLAGS := $(shell $(MINGW_PKG_CONFIG) --cflags libcjson)
  MINGW_CJSON_LIBS   := $(shell $(MINGW_PKG_CONFIG) --libs --static libcjson 2>/dev/null || echo "-lcjson")
endif

override MINGW_CFLAGS += $(MINGW_YAML_CFLAGS) $(MINGW_CURL_CFLAGS) $(MINGW_CRYPTO_CFLAGS) $(MINGW_CJSON_CFLAGS)
MINGW_ALL_LIBS := $(MINGW_YAML_LIBS) $(MINGW_CURL_LIBS) $(MINGW_CRYPTO_LIBS) $(MINGW_SSL_LIBS) $(MINGW_CJSON_LIBS) -lws2_32 -lbcrypt

.PHONY: windows windows64 windows32 clean-win check-ascii format format-check lint

# Cross build runs the same host-side gates (ASCII / format / lint) as the
# native build, then cross-compiles. clang-tidy is host-only - it never
# produces or links any object code.
windows: check-ascii format-check lint windows64

windows64:
	$(MAKE) -f Makefile.cross $(MINGW_TARGET) MINGW_W64=x86_64-w64-mingw32

windows32:
	$(MAKE) -f Makefile.cross $(MINGW_TARGET) MINGW_W64=i686-w64-mingw32

$(MINGW_TARGET): $(MINGW_OBJS) $(if $(MINGW_CJSON_SRC),$(MINGW_OBJDIR)/cJSON.o)
	$(MINGW_CC) $(MINGW_CFLAGS) $(MINGW_LDFLAGS) -o $@ $^ $(MINGW_ALL_LIBS)

$(MINGW_OBJDIR)/%.o: $(SRCDIR)/%.c | $(MINGW_OBJDIR)
	$(MINGW_CC) $(MINGW_CFLAGS) -c -o $@ $<

ifdef MINGW_CJSON_SRC
$(MINGW_OBJDIR)/cJSON.o: $(MINGW_CJSON_SRC) | $(MINGW_OBJDIR)
	$(MINGW_CC) $(MINGW_CFLAGS) -c -o $@ $<
endif

$(MINGW_OBJDIR):
	mkdir -p $(MINGW_OBJDIR)

clean-win:
	rm -rf $(MINGW_OBJDIR) $(MINGW_TARGET)

check-ascii:
	@$(SCRIPTS)/check-ascii.py $(SRCDIR)/*.c $(SRCDIR)/*.h $(SCRIPTS)/check-ascii.py Makefile.cross

# Host-side format / lint gates (mirror of the main Makefile). Definitions
# and rationale live in .clang-format / .clang-tidy at the project root.
format:
	$(CLANG_FORMAT) -i $(FORMAT_SOURCES)

format-check:
	@$(CLANG_FORMAT) --dry-run --Werror $(FORMAT_SOURCES)

# TIDY_FLAGS uses the HOST (native) include paths, not the MinGW ones.
# clang-tidy is a host tool that parses C source for semantic issues; it
# never produces object code, so cross-specific sysroot headers (which
# require a Win32 target triple and would fail with "Only Win32 target is
# supported!") must not be on the include path. The native dev packages
# installed for `make` provide identical headers in a host-parseable form.
HOST_YAML_CFLAGS   := $(shell pkg-config --cflags yaml-0.1 2>/dev/null)
HOST_CURL_CFLAGS   := $(shell pkg-config --cflags libcurl 2>/dev/null)
HOST_CRYPTO_CFLAGS := $(shell pkg-config --cflags libcrypto 2>/dev/null)
HOST_CJSON_CFLAGS  := $(shell pkg-config --cflags libcjson 2>/dev/null)

TIDY_FLAGS := -std=c17 -D_DEFAULT_SOURCE -I $(SRCDIR) \
              $(HOST_YAML_CFLAGS) $(HOST_CURL_CFLAGS) \
              $(HOST_CRYPTO_CFLAGS) $(HOST_CJSON_CFLAGS)

lint:
	@set -e; \
	for src in $(LINT_SOURCES); do \
		printf "[clang-tidy] %s\n" "$$src"; \
		$(CLANG_TIDY) --quiet --warnings-as-errors='*' \
		              --config-file=.clang-tidy \
		              "$$src" -- $(TIDY_FLAGS); \
	done
